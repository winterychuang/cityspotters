<div id = "recpopup">
    <div>
        <h1> Recommendations </h1>
    </div>
    <div>
        <button type = "button"> 
            <a href = "/recommendations" > Go to Recommendations </a>
        </button>
    </div>
    <div>
           <% for(let i = 0; i < 4;i++){ %>
        <% let randomizeno = Math.floor(Math.random()*lockeys.length) %>
        <%if(usednums.includes(randomizeno) == false){ %>
            <div>
                <p> <%= data[lockeys[randomizeno]]["name"] %> </p> 
                <img src = <%= data[lockeys[randomizeno]]["picture"] %> > 
                <a href = /map> Go to Info Page-- still needs working on </a>
            </div>
        <% } %>
        
        <% usednums.push(randomizeno) %>
       
    <% } %>
    </div>

</div>