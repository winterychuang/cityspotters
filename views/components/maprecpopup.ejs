<div id ="real_recpopup">
<button id="hide_page_button" type= "button" onclick = "document.getElementById('real_recpopup').style.display = 'none'"> X </button>
<div id = "recpopup">
    <div>
        <p id = "recheader"> Recommendations </p>
    </div>
    <div id="popup_buttons">
        <a id="go_to_rec" href = "/recommendations" > Go to Recommendations </a>
    </div>
    <div>
           <% for(let i = 0; i < 4;i++){ %>
        <% let randomizeno = Math.floor(Math.random()*lockeys.length) %>
        <%if(usednums.includes(randomizeno) == false){ %>
            <div class="popup"> 
                <div>
                    <img src = <%= data[lockeys[randomizeno]]["picture"] %> > 
                </div>
                <div id="vert_align">
                    <p> <%= data[lockeys[randomizeno]]["name"] %> </p>
                    <a href =  <%= "/information/" + lockeys[randomizeno] %> > Go to Info Page</a>
                </div>
            </div>
        <% } %>
        
        <% usednums.push(randomizeno) %>
       
    <% } %>
    </div>

</div>

</div>
 