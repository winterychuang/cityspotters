<div>
  <p class="specialtext">Timetable</p>
  <div id="timetable_body">
    <div class="timetable_day">
      <p>Monday : <%= data.time.Monday %></p>
    </div>
    <div class="timetable_day">
      <p>Tuesday: <%= data.time.Tuesday %></p>
    </div>
    <div class="timetable_day">
      <p>Wednesday: <%= data.time.Wednesday %></p>
    </div>
    <div class="timetable_day">
      <p>Thursday: <%= data.time.Thursday %></p>
    </div>
    <div class="timetable_day">
      <p>Friday: <%= data.time.Friday %></p>
    </div>
    <div class="timetable_day">
      <p>Saturday: <%= data.time.Saturday %></p>
    </div>
    <div class="timetable_day">
      <p>Sunday: <%= data.time.Sunday %></p>
    </div>
  </div>
</div>
