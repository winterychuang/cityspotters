<!DOCTYPE html>
    <head>
        <link rel="stylesheet" href="/css/recommendations.css"/>
        <link rel= "stylesheet" href= "/css/standardization.css"/>
            <link rel="preconnect" href="https://fonts.googleapis.com">
            <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
            <link href="https://fonts.googleapis.com/css2?family=Afacad:ital,wght@0,400..700;1,400..700&display=swap" rel="stylesheet">
            <link href="https://fonts.cdnfonts.com/css/merge-one" rel="stylesheet">
    </head>
    <body>
        <div id="top-nav">
            <p class="pagetitle"> Recommendations </p>
            <%- include('./components/header') %>  
        </div> 
    <div class="page">
        <div class="section" id="daily_rec">
            <div>
                <p class="subheading"> Recommendation of the Day: </p>
            </div>
            <% for(let i = 0; i < 1;i++){ %>
                    <% let randomizeno = parseInt(Math.random()*lockeys.length) %>
                    <%if(usednums.includes(randomizeno) == false){ %>
                        <div id="recbox">
                            <div >
                                <img id="random_img" src = "<%= data[lockeys[randomizeno]]["picture"] %>" >
                             </div>
                            <div id="recbox_name">
                                <p> <%= data[lockeys[randomizeno]]["name"] %> </p>
                            </div>
                             <div id ="link_to">
                                <a  href = <%= "/information/" + lockeys[randomizeno] %>> Go to Info Page </a>
                             </div>
                        </div>
                    <% } %>
                    
                    <% usednums.push(randomizeno) %>
                
                <% } %>
        </div>
        <div class="section" id="random_rec">
            <p class="subheading">Randomized Recs </p>
        <form action="/recommendations/result" method="post">
            <label for="uservalue"> Type a number here to give that amount of recommendations back! </label>
            <div id="submit_form">
            <input type = "text" name="uservalue_input" />
            <button type = "submit"> Surprise me! </button>
            </div>
        </form>
        </div>
    </div> 


    </body>
</html>

