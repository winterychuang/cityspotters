<!DOCTYPE html>
    <head>
        <link rel=""stylesheet" href="/css/recommendations.css"%>
        <div>
            <link rel="preconnect" href="https://fonts.googleapis.com">
            <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
            <link href="https://fonts.googleapis.com/css2?family=Afacad:ital,wght@0,400..700;1,400..700&display=swap" rel="stylesheet">
            <link href="https://fonts.cdnfonts.com/css/merge-one" rel="stylesheet">
        </div>
    </head>
    <body>
        <header> 
            <h1> Recommendations </h1>
            <%- include('./components/header') %>
        </header>
       
    <div>  
        <h3> Recommendation of the Day: </h3>
        <% for(let i = 0; i < 1;i++){ %>
                <% let randomizeno = parseInt(Math.random()*lockeys.length) %>
                <%if(usednums.includes(randomizeno) == false){ %>
                    <div>
                        <p> <%= data[lockeys[randomizeno]]["name"] %> </p> 
                        <img src = <%= data[lockeys[randomizeno]]["picture"] %> > 
                        <a href = /map> Go to Info Page-- still needs working on </a>
                    </div>
                <% } %>
                
                <% usednums.push(randomizeno) %>
            
            <% } %>
    </div>
    <div>
        <h3>Randomized Recs </h3>
    <form action="/recommendations/result" method="post">
        <label for="uservalue"> Type a number here! </label>
        <input type = "text" name="uservalue_input"/>
        <button type = "submit"> Surprise me! </button>
    </form>
    <script src="/script/rec.js"></script>
    
    </div>
    
    </body>
</html>

