<!DOCTYPE html>
<html>
        <link rel="stylesheet" href="/css/recommendation_result.css"%>
        <div>
            <link rel="preconnect" href="https://fonts.googleapis.com">
            <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
            <link href="https://fonts.googleapis.com/css2?family=Afacad:ital,wght@0,400..700;1,400..700&display=swap" rel="stylesheet">
            <link href="https://fonts.cdnfonts.com/css/merge-one" rel="stylesheet">
        </div>
    </head>
    <body>
        <div id="top-nav">
            <p class="pagetitle"> Results </p>
            <%- include('./components/header') %>  
         </div> 

        <div>
           <% for(let i = 0; i < usernum;i++){ %>
        <% let randomizeno = Math.floor(Math.random()*lockeys.length) %>
        <%if(usednums.includes(randomizeno) == false){ %>
            <div id="popup"> 
                <div id="img_result">
                    <img src = <%="../" + data[lockeys[randomizeno]]["picture"] %> > 
                </div>
                <div id="vert_align">
                    <p> <%= data[lockeys[randomizeno]]["name"] %> </p>
                    <a href =  <%= "/information/" + lockeys[randomizeno] %> > Go to Info Page</a>
                </div>
            </div>
        <% } %>
        
        <% usednums.push(randomizeno) %>
       
    <% } %>
    </div>
           
    </body>
</html>