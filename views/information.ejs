<!DOCTYPE html>
<html>
    <head>
        <div>
            <link rel="stylesheet" href="/css/information.css">
            <link rel="stylesheet" href="/css/macrecpopup-comp.css">
        </div>

        <div>
            <link rel="preconnect" href="https://fonts.googleapis.com">
            <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
            <link href="https://fonts.googleapis.com/css2?family=Afacad:ital,wght@0,400..700;1,400..700&display=swap" rel="stylesheet">
            <link href="https://fonts.cdnfonts.com/css/merge-one" rel="stylesheet">
        </div>
        

    </head>
    <body>
        
        <header> 
            <%- include('./components/header') %>
        </header>
        <div id="page">
            <div id="left-info" class="section">
                <div id="heading">
                    <h1> <%= data.name %> </h1>
                    <h4> <%= data.address %> </h4>
                    <div id="site-break">
                        <hr>
                        <a href = <%= data.link %> > Go to site </a>
                </div>
                </div>
                
                <div id="timetable_box">
                    <%- include('./components/timetable') %>
                </div>    
                <div id="comment_box">
                    <%- include('./components/comment',{data:data}) %>
                </div>
                
            </div>
            
            <div id="right-info" class="section">
                <img src = <%= "../" + data.picture %> > 
                <div id="description">
                    <p>
                        <%- include('./components/descbox') %>
                    </p>
                </div>
            </div>
            

            
        </div>
        
        
    </body>
</html>