<!DOCTYPE html>
<html>
    <head>
        <link rel="stylesheet" href="/css/profile.css"%>
        <div>
            <link rel="preconnect" href="https://fonts.googleapis.com">
            <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
            <link href="https://fonts.googleapis.com/css2?family=Afacad:ital,wght@0,400..700;1,400..700&display=swap" rel="stylesheet">
            <link href="https://fonts.cdnfonts.com/css/merge-one" rel="stylesheet">
        </div> 
    </head>
    <body>
        <div id="top-nav">
            <p class="pagetitle"> Profile </p>
            <%- include('./components/header') %>  
        </div> 
        <div class ="page">
        <div id="profile">
            <div id = "profile_left">
                <img id = "profile_pic" src= <%= "../" + user.user1.profile_picture %> >
                <p id="bio"> <%= user.user1.bio %> </p>
            </div>

            <div id = "profile_right">
                <h1> <%= user.user1.username %> </h1>
                <p> <%= user.user1.email %> </p> 
            </div>     
        </div>

        </div>


        

    </body>
</html>